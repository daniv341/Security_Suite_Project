# Copia este archivo a .env para desarrollo local (fuera de Docker).
# En docker-compose.yml estas mismas variables ya están definidas
# con valores por defecto para levantar el stack completo.

# Cadena de conexión que usa la app para hablar con PostgreSQL.
DATABASE_URL=postgres://security_user:security_pass@localhost:5432/security_suite

# Dirección y puerto donde escucha el servidor Axum.
SERVER_ADDR=0.0.0.0:8080

# Nivel de logging (tracing_subscriber / EnvFilter).
RUST_LOG=info

# Variables que consume el contenedor de PostgreSQL (docker-compose.yml).
POSTGRES_USER=security_user
POSTGRES_PASSWORD=security_pass
POSTGRES_DB=security_suite
